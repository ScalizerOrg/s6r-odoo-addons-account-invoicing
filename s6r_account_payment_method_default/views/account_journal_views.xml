<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_journal_form_payment_method_default" model="ir.ui.view">
        <field name="name">account.journal.form.payment.method.default</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='inbound_payment_method_line_ids']/list/field[@name='name']"
                position="after"
            >
                <field name="is_default" />
            </xpath>
            <xpath
                expr="//field[@name='outbound_payment_method_line_ids']/list/field[@name='name']"
                position="after"
            >
                <field name="is_default" />
            </xpath>
        </field>
    </record>
</odoo>
