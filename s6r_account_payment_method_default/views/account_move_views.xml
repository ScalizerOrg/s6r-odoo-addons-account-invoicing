<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Form: only payment methods of active journals -->
    <record id="view_move_form_payment_method_default" model="ir.ui.view">
        <field name="name">account.move.form.payment.method.default</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='preferred_payment_method_line_id'][contains(@domain, 'inbound')]"
                position="attributes"
            >
                <attribute
                    name="domain"
                >[('payment_type', '=', 'inbound'), ('journal_id.active', '=', True), ('company_id', 'parent_of', company_id)]</attribute>
            </xpath>
            <xpath
                expr="//field[@name='preferred_payment_method_line_id'][contains(@domain, 'outbound')]"
                position="attributes"
            >
                <attribute
                    name="domain"
                >[('payment_type', '=', 'outbound'), ('journal_id.active', '=', True), ('company_id', 'parent_of', company_id)]</attribute>
            </xpath>
        </field>
    </record>
    <!-- Base list (inherited by every invoice/bill/refund list) -->
    <record id="view_invoice_tree_payment_method_default" model="ir.ui.view">
        <field name="name">account.invoice.list.payment.method.default</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="multi_edit">1</attribute>
            </xpath>
            <xpath expr="//field[@name='ref']" position="after">
                <field
                    name="preferred_payment_method_line_id"
                    string="Payment Method"
                    optional="hide"
                    options="{'no_create': True, 'no_open': True}"
                />
            </xpath>
        </field>
    </record>
    <!-- Customer lists: inbound methods -->
    <record id="view_out_invoice_tree_payment_method_default" model="ir.ui.view">
        <field name="name">account.out.invoice.list.payment.method.default</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree" />
        <field name="arch" type="xml">
            <field name="preferred_payment_method_line_id" position="attributes">
                <attribute
                    name="domain"
                >[('payment_type', '=', 'inbound'), ('journal_id.active', '=', True)]</attribute>
            </field>
        </field>
    </record>
    <record id="view_out_credit_note_tree_payment_method_default" model="ir.ui.view">
        <field name="name">account.out.credit.note.list.payment.method.default</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_credit_note_tree" />
        <field name="arch" type="xml">
            <field name="preferred_payment_method_line_id" position="attributes">
                <attribute
                    name="domain"
                >[('payment_type', '=', 'inbound'), ('journal_id.active', '=', True)]</attribute>
            </field>
        </field>
    </record>
    <!-- Vendor lists: outbound methods (bill/refund inherit view_in_invoice_tree) -->
    <record id="view_in_invoice_tree_payment_method_default" model="ir.ui.view">
        <field name="name">account.in.invoice.list.payment.method.default</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_tree" />
        <field name="arch" type="xml">
            <field name="preferred_payment_method_line_id" position="attributes">
                <attribute
                    name="domain"
                >[('payment_type', '=', 'outbound'), ('journal_id.active', '=', True)]</attribute>
            </field>
        </field>
    </record>
</odoo>
